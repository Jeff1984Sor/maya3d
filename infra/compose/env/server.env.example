# Modelo do /srv/print3d/<stack>/.env (permissão 600, dono mayacorp22).
# O ops/bootstrap-server.sh gera este arquivo com segredos aleatórios; revise e complete.

# --- Domínio e registro de imagens ---
BASE_DOMAIN=example.com
REGISTRY=ghcr.io/jeff1984sor   # sempre minúsculo

# --- Banco (Postgres no host; um banco por stack) ---
DATABASE_URL=postgresql+psycopg://print3d_staging:TROQUE@host.docker.internal:5432/print3d_staging

# --- Segurança ---
# Fernet (tokens de terceiros): base64 urlsafe de 32 bytes. NUNCA trocar sem recifrar o banco.
FERNET_KEY=
CORS_ORIGINS=["https://loja-staging.example.com","https://admin-staging.example.com"]

# --- IA (modelos por tarefa vêm daqui; nada hardcoded) ---
AI_PROVIDER=claude
AI_API_KEY=
AI_MODEL_DEFAULT=
AI_MODEL_GUARDIAN=
AI_MODEL_PERSONALIZER=
AI_MODEL_EMBEDDING=

# --- Backup (ops/backup.sh) ---
GCS_BACKUP_BUCKET=
