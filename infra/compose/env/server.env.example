# Modelo do /srv/print3d/<stack>/.env (permissão 600, dono mayacorp22).
# O ops/bootstrap-server.sh gera este arquivo com segredos aleatórios e detecta PUBLIC_HOST.

# --- Acesso (sem domínio por enquanto: pelo IP, em portas dedicadas; ADR 0007) ---
PUBLIC_HOST=0.0.0.0              # IP externo do servidor (o bootstrap preenche)
BASE_DOMAIN=                     # vazio = modo IP. Quando houver domínio, ver ADR 0007
REGISTRY=ghcr.io/jeff1984sor     # sempre minúsculo

# --- Banco (Postgres no host; um banco por stack) ---
DATABASE_URL=postgresql+psycopg://print3d_staging:TROQUE@/print3d_staging?host=/var/run/postgresql

# --- Segurança ---
# Fernet (tokens de terceiros): base64 urlsafe de 32 bytes. NUNCA trocar sem recifrar o banco.
FERNET_KEY=
CORS_ORIGINS=["http://0.0.0.0:38001","http://0.0.0.0:38002"]

# --- IA (modelos por tarefa vêm daqui; nada hardcoded) ---
AI_PROVIDER=claude
AI_API_KEY=
AI_MODEL_DEFAULT=
AI_MODEL_GUARDIAN=
AI_MODEL_PERSONALIZER=
AI_MODEL_EMBEDDING=

# --- Backup (ops/backup.sh) ---
GCS_BACKUP_BUCKET=               # vazio = backup só local (em ${STACK_DIR}/backups)
