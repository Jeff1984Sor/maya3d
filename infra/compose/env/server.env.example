# Modelo do /srv/print3d/<stack>/.env (permissão 600, dono mayacorp22).
# O ops/bootstrap-server.sh gera este arquivo com segredos aleatórios e detecta PUBLIC_HOST.

# --- Acesso (sem domínio por enquanto: pelo IP, em portas dedicadas; ADR 0007) ---
PUBLIC_HOST=0.0.0.0              # IP externo do servidor (o bootstrap preenche)
BASE_DOMAIN=                     # vazio = modo IP. Quando houver domínio, ver ADR 0007
REGISTRY=ghcr.io/jeff1984sor     # sempre minúsculo

# --- Banco (Postgres no host; um banco por stack) ---
DATABASE_URL=postgresql+psycopg://print3d_staging:TROQUE@/print3d_staging?host=/var/run/postgresql

# --- Segurança ---
# Fernet (tokens de terceiros): base64 urlsafe de 32 bytes. NUNCA trocar sem recifrar o banco.
FERNET_KEY=
# Header X-Admin-Token das rotas /v1/admin/* (vazio = admin desligado). Gerado pelo bootstrap.
ADMIN_API_TOKEN=
# Senha do painel admin (login). Sessão assinada com ADMIN_SESSION_SECRET (ou o token acima).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=false   # true quando houver HTTPS
CORS_ORIGINS=["http://0.0.0.0:38001","http://0.0.0.0:38002"]

# --- IA e WhatsApp: o dono configura pelo painel (Integrações), cifrado no banco com a
# FERNET_KEY acima. As linhas abaixo são só alternativa; o painel vence o .env. ---
# --- IA (modelos por tarefa vêm daqui; nada hardcoded) ---
AI_PROVIDER=claude          # claude | openai — modelos por tarefa são escolhidos no painel (IA)
AI_API_KEY=
AI_MODEL_DEFAULT=
AI_MODEL_GUARDIAN=
AI_MODEL_PERSONALIZER=
AI_MODEL_EMBEDDING=
# Busca por significado (loja e assistente): a Anthropic não tem embeddings. Com
# AI_PROVIDER=openai usa a mesma chave; com claude, preencha as duas linhas abaixo.
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_API_KEY=
SEMANTIC_MAX_DISTANCE=0.75       # maior = mostra resultados mais distantes (teste no painel IA)
ASSISTANT_PER_MINUTE=8           # assistente da loja: mensagens por visitante/minuto
ASSISTANT_DAILY_LIMIT=500        # e total por dia (proteção de custo)

# --- WhatsApp (API oficial da Meta: Cloud API) ---
# Envio liga com TOKEN + PHONE_NUMBER_ID + GRAPH_VERSION (ex.: v23.0 — confira a versão atual
# na documentação da Meta). Respostas (botões e seus comandos) precisam do webhook
# https://<domínio>/v1/webhooks/whatsapp registrado na Meta com o mesmo VERIFY_TOKEN.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_STATUS=        # template aprovado com 1 variável, usado fora da janela de 24 h
WHATSAPP_TEMPLATE_LANG=pt_BR

# --- Backup (ops/backup.sh) ---
GCS_BACKUP_BUCKET=               # vazio = backup só local (em ${STACK_DIR}/backups)
